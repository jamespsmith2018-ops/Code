{
  "name": "meteorite-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive portal for exploring recorded meteorite landings",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch-data": "node scripts/fetch-data.mjs",
    "ukmon": "node scripts/build-ukmon.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
